# Supabase project credentials (ANON key is safe for the browser; service-role key is NOT — never ship it here).
# Create a project at https://supabase.com, then copy the URL and anon key from
# Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: show the "DEMO DATA" banner on the leaderboard until real results exist.
# Flip to "false" once real competition results are uploaded.
VITE_SHOW_DEMO_BANNER=true
